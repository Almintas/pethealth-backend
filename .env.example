# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on
PORT=3000

# MongoDB connection string (on some hosts use DATABASE_URL or MONGO_URL instead — mapped automatically)
MONGODB_URI=mongodb://localhost:27017/pethealth

# JWT signing secret (development only — use 32+ random characters in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional JWT lifetime (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# Comma-separated browser origins allowed to call the API (required in production)
# Example: https://app.example.com,https://www.example.com
CORS_ORIGIN=http://localhost:5173

# Global API rate limit (requests per THROTTLE_TTL_MS window, per IP)
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# Stricter limits for login and register mutations
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_MS=60000

# Pet profile photos (Cloudinary). API starts without these; upload/delete return a clear error until set.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional Cloudinary folder prefix for pet photos (default: pethealth/pets)
# CLOUDINARY_PET_PHOTO_FOLDER=pethealth/pets

# Transactional email (Resend) — backend only, never expose to the frontend
RESEND_API_KEY=
RESEND_FROM_EMAIL="PetHealth <notifications@your-domain.com>"

# Links in notification emails (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Allow sendTestNotificationEmail GraphQL mutation in development
ENABLE_DEV_EMAIL_TEST=true
